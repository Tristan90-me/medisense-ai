# Copy to .env for local development. In production (Render), set each of
# these as dashboard environment variables instead — never commit real values.

PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>

# JWT signing secret — must be a long, random, unguessable string in
# production (not a word/phrase). JWT_EXPIRE uses jsonwebtoken's duration
# format, e.g. "7d", "1h".
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRE=7d

# SMTP credentials used for verification/OTP/admin-invite emails.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="MediSense AI <no-reply@example.com>"

# The deployed frontend's origin(s) — used for the CORS allowlist AND to
# build verification/admin-invite links in outgoing emails. Required in
# production; a comma-separated list is supported (e.g. a custom domain
# plus its vercel.app URL). No trailing slash.
CLIENT_URL=https://your-app.vercel.app

GROQ_API_KEY=
GEMINI_API_KEY=
